# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── UltraMSG (WhatsApp) ──────────────────────────────────────────────────────
# Get from: https://app.ultramsg.com → Instance → Settings
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=your-ultramsg-token

# ─── Retell AI (Voice) ────────────────────────────────────────────────────────
# Get from: https://app.retellai.com → API Keys
RETELL_API_KEY=key_xxxxxxxxxxxx
# The Retell phone number to call FROM (must be purchased in Retell dashboard)
RETELL_FROM_NUMBER=+15551234567

# ─── Meta (Lead Ads) ──────────────────────────────────────────────────────────
# Set this to any random string — use the same value in Meta App Dashboard
META_VERIFY_TOKEN=your-random-verify-token
# Meta App Secret (from App Dashboard → App Settings → Basic)
META_APP_SECRET=your-meta-app-secret
# Page Access Token (from Meta for Developers → Tools → Graph API Explorer)
META_ACCESS_TOKEN=your-meta-access-token
META_PAGE_ID=your-facebook-page-id

# ─── Cron security ────────────────────────────────────────────────────────────
# Random secret to protect /api/scheduled/* endpoints from unauthorized calls
CRON_SECRET=change-me-to-random-string

# ─── Optional: Claude API (for transcript analysis) ───────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
