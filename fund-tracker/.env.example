# =============================================================================
# Fund Tracker & Presenter — Environment Variables
# Copy this file to backend/.env and update the values
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (zero setup, stored in backend/fund_tracker.db)
DATABASE_URL=sqlite:///./fund_tracker.db

# PostgreSQL example:
# DATABASE_URL=postgresql://funduser:fundpass@localhost:5432/fund_tracker

# ── Caching ───────────────────────────────────────────────────────────────────
# Optional Redis cache (improves performance under load)
# REDIS_URL=redis://localhost:6379/0

# Cache TTL in hours
CACHE_TTL_HOURS=24
NEWS_CACHE_TTL_HOURS=6

# ── External APIs (all optional) ──────────────────────────────────────────────
# NewsAPI.org — enables fallback news source (free tier: 100 req/day)
# NEWSAPI_KEY=your_newsapi_key_here

# OpenFIGI — increases rate limits for ISIN → ticker lookups
# (works without key, but rate limited)
# OPENFIGI_API_KEY=your_openfigi_key_here

# OpenAI — enables AI-powered one-sentence news summaries (gpt-4o-mini)
# OPENAI_API_KEY=your_openai_key_here

# ── Application ───────────────────────────────────────────────────────────────
# Set to true to auto-seed demo funds on backend startup
DEMO_MODE=false

# Maximum CSV file upload size in megabytes
MAX_CSV_SIZE_MB=10

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
